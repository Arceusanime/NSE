# Copy this file to .env. Never commit real credentials.
NSE_ANGEL_API_KEY=
NSE_ANGEL_CLIENT_CODE=
NSE_ANGEL_PASSWORD=
NSE_ANGEL_TOTP_SECRET=

# Values registered/required by SmartAPI. Verify the public IP in your Angel One app.
NSE_ANGEL_MAC_ADDRESS=auto
NSE_ANGEL_LOCAL_IP=auto
NSE_ANGEL_PUBLIC_IP=auto

# Keep the first rollout bounded. Use comma-separated underlying names from the Angel master.
NSE_FNO_SYMBOLS=NIFTY,BANKNIFTY,FINNIFTY,RELIANCE,TCS,INFY
NSE_LIVE_DATA_ENABLED=true
